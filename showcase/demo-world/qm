#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs a qm command inside the demo world (its env only):
# `showcase/demo-world/qm show gift-cards`. QM_DEMO_WORLD picks another
# world directory than showcase/out/demo-world.
require_relative "lib/demo_world"

world = DemoWorld::World.new(ENV["QM_DEMO_WORLD"] || DemoWorld::DEFAULT_ROOT)
abort "no demo world at #{world.root} — run showcase/demo-world/seed first" unless File.directory?(world.qm_root)
Dir.chdir(world.home)
exec(world.env, RbConfig.ruby, DemoWorld::QM_EXECUTABLE, *ARGV, unsetenv_others: true)
