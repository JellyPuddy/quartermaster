#!/usr/bin/env ruby
# frozen_string_literal: true

# The demo world's `claude`: never a real model.
#
# `claude -p ...` prints fixtures/claude/print.txt and exits (with
# --json-schema, as build progress asks, fixtures/claude/structured.json
# when it exists). Any other call
# (a chat pane's `claude` or `claude --resume ID`) prints a canned Claude
# Code screen and then waits until the pane is killed. The screen is the
# first that exists of fixtures/claude/sessions/<resumed id>.txt,
# fixtures/claude/<slug>.txt (slug from QM_ITEM, else the tmux session's
# name, which qm sets to the item's slug) and fixtures/claude/default.txt.
require "json"
require "time"

world = ENV["QM_DEMO_WORLD"] || File.expand_path("..", __dir__)
dir = File.join(world, "fixtures", "claude")

begin
  File.open(File.join(world, "log", "claude.jsonl"), "a") do |f|
    f.puts(JSON.generate({ "ts" => Time.now.iso8601, "argv" => ARGV, "cwd" => Dir.pwd, "item" => ENV["QM_ITEM"] }))
  end
rescue SystemCallError
  nil
end

if ARGV.include?("-p") || ARGV.include?("--print")
  structured = File.join(dir, "structured.json")
  if ARGV.include?("--json-schema") && File.file?(structured)
    print File.read(structured)
    exit 0
  end
  print File.read(File.join(dir, "print.txt")) rescue puts("Done.")
  exit 0
end

resume = ARGV[ARGV.index("--resume") + 1] if ARGV.index("--resume")
slug = ENV["QM_ITEM"].to_s
if slug.empty? && ENV["TMUX"]
  slug = IO.popen(["tmux", "display-message", "-p", "#S"], err: File::NULL, &:read).to_s.strip rescue ""
end
candidates = []
candidates << File.join(dir, "sessions", "#{File.basename(resume)}.txt") if resume
candidates << File.join(dir, "#{File.basename(slug)}.txt") unless slug.empty?
candidates << File.join(dir, "default.txt")
screen = candidates.find { |path| File.file?(path) }

print "\e[2J\e[H"
print(screen ? File.read(screen).gsub(/(?<!\r)\n/, "\r\n") : "✻ Claude Code (demo)\r\n> ")
$stdout.flush
trap("TERM") { exit 0 }
trap("HUP") { exit 0 }
loop { sleep 3600 }
