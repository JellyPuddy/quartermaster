#!/usr/bin/env ruby
# frozen_string_literal: true

# Installed under every name in DemoWorld::HARMLESS_STUBS: logs the call to
# log/stubs.jsonl and does nothing else, so the demo GUI never opens an app,
# posts a notification, keeps the Mac awake or reaches the user's dev server.
# Two answer as the Bakery webshop's tools would, from files only:
# `devserver` keeps "<mode> <root>" in ~/.devserver/state (switch writes it,
# stop leaves it) and ~/.devserver/running while it "serves", which `status`
# checks; `bakery-test-db drop PATH` names one database per worktree. curl
# fails as if no status URL answered.
require "fileutils"
require "json"
require "time"

world = ENV["QM_DEMO_WORLD"] || File.expand_path("..", __dir__)
name = File.basename($PROGRAM_NAME)

begin
  File.open(File.join(world, "log", "stubs.jsonl"), "a") do |f|
    f.puts(JSON.generate({ "ts" => Time.now.iso8601, "program" => name, "argv" => ARGV }))
  end
rescue SystemCallError
  nil
end

def devserver(argv)
  dir = File.join(Dir.home, ".devserver")
  running = File.join(dir, "running")
  case argv.first
  when "status" then exit(File.exist?(running) ? 0 : 1)
  when "stop" then FileUtils.rm_f(running)
  when "switch"
    path, mode = argv[1, 2]
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "state"), "#{mode} #{path}\n")
    FileUtils.touch(running)
  end
  exit 0
end

case name
when "curl" then exit 7
when "devserver" then devserver(ARGV)
when "bakery-test-db"
  puts "bakery_test_#{File.basename(ARGV[1]).tr("-", "_")}" if ARGV[0] == "drop" && ARGV[1] && ARGV.include?("--dry-run")
  exit 0
else exit 0
end
